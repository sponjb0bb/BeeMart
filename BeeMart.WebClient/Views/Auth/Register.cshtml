@model BeeMart.WebClient.Models.Auth.RegisterRequest
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Register Akun</h1>

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <form asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" placeholder="Username" autofocus />
                <span asp-validation-for="Username" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="RePassword">Re-Password</label>
                <input asp-for="RePassword" type="password" class="form-control" placeholder="Re-Password" />
                <span asp-validation-for="RePassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Role</label>
                <select asp-for="Role" class="form-control">
                    <option value="Cashier">Kasir</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-blue" style="width:100%;">Daftar</button>
        </form>

        <a class="auth-link" asp-controller="Auth" asp-action="Login">Sudah punya akun? Login</a>
    </div>
</div>
