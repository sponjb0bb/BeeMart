@using System.Globalization
@model BeeMart.WebClient.Models.Transactions.NewTransactionViewModel
@{
    ViewData["Title"] = "New Transaction";
    ViewData["ActiveTab"] = "new";
    Layout = "_Layout";
    var idr = CultureInfo.GetCultureInfo("id-ID");
    string Rp(decimal v) => "Rp " + v.ToString("#,##0", idr);
}

@await Html.PartialAsync("_PosHeader")

<div class="content">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <div class="panel">
        <div class="form-group">
            <label>Invoice No</label>
            <input class="form-control read-only" value="@Model.InvoiceNo" readonly />
        </div>

        <form asp-action="Search" method="post" class="row-flex">
            @Html.AntiForgeryToken()
            <div class="form-group" style="flex:1; margin-bottom:0;">
                <label>Cari Barang (Ketik: Apel / Susu, lalu tekan Enter)</label>
                <input name="keyword" class="form-control" placeholder="Ketik nama barang..."
                       value="@Model.SearchKeyword" autofocus />
            </div>
            <button type="submit" class="btn btn-blue">Cari</button>
        </form>
    </div>

    @if (Model.SearchResults.Any())
    {
        <div class="panel">
            <h2>Hasil Pencarian</h2>
            <table class="data">
                <thead>
                    <tr>
                        <th>Nama Barang</th><th>Berat</th><th>Stock</th><th>Harga</th><th>Diskon</th><th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.SearchResults)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Weight</td>
                        <td>@p.Stock</td>
                        <td>@Rp(p.Price)</td>
                        <td>@p.Discount%</td>
                        <td>
                            <form asp-action="Select" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProduct" value="@p.IdProduct" />
                                <input type="hidden" name="keyword" value="@Model.SearchKeyword" />
                                <button type="submit" class="btn btn-blue btn-sm">Pilih</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (Model.SelectedProduct is { } sp)
    {
        <div class="panel">
            <h2>Barang Terpilih: @sp.Name</h2>
            <form asp-action="AddToCart" method="post" class="row-flex">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idProduct" value="@sp.IdProduct" />
                <input type="hidden" name="name" value="@sp.Name" />
                <input type="hidden" name="price" value="@sp.Price.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="discount" value="@sp.Discount.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="stock" value="@sp.Stock" />
                <input type="hidden" name="keyword" value="@Model.SearchKeyword" />
                <div><label>Harga Satuan</label><div>@Rp(sp.Price)</div></div>
                <div><label>Sisa Stock</label><div>@sp.Stock</div></div>
                <div class="form-group" style="margin-bottom:0;">
                    <label>Qty</label>
                    <input name="qty" type="number" min="1" max="@sp.Stock" value="1" class="form-control" style="width:100px;" />
                </div>
                <button type="submit" class="btn btn-blue">Masukkan ke Keranjang</button>
            </form>
        </div>
    }

    <div class="panel">
        <h2>Daftar Belanjaan</h2>
        <table class="data">
            <thead>
                <tr><th>Nama Barang</th><th>Harga</th><th>Diskon</th><th>Qty</th><th>Subtotal</th><th>Aksi</th></tr>
            </thead>
            <tbody>
            @if (!Model.Cart.Any())
            {
                <tr class="empty-row"><td colspan="6">Keranjang kosong</td></tr>
            }
            else
            {
                @foreach (var c in Model.Cart)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@Rp(c.Price)</td>
                        <td>@c.Discount%</td>
                        <td>@c.Qty</td>
                        <td>@Rp(c.SubTotal)</td>
                        <td>
                            <form asp-action="RemoveFromCart" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProduct" value="@c.IdProduct" />
                                <button type="submit" class="btn btn-red btn-sm">Hapus</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>

        <p class="total" style="margin-top:1rem;">Total: @Rp(Model.Total)</p>

        <form asp-action="Submit" method="post" class="row-flex">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:0;">
                <label>Metode Pembayaran</label>
                <select name="idPaymentMethod" class="form-control">
                    @foreach (var pm in Model.PaymentMethods)
                    {
                        <option value="@pm.IdPaymentMethod">@pm.MethodName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-blue" @(Model.Cart.Any() ? "" : "disabled")>Submit Transaksi</button>
        </form>
    </div>
</div>
