@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="content">
    <div class="panel">
        <h1 class="text-danger">Terjadi kesalahan.</h1>
        <p>Maaf, terjadi kesalahan saat memproses permintaan Anda.</p>

        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
</div>
